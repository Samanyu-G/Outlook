# Copy this file to ".env" and fill in the two values from
# Supabase Dashboard -> Project Settings -> API.
# Leave them empty to run in demo mode (data stays in your browser).
#
# The anon key is meant to be public: it ships inside the app.
# Your data is protected by the Row Level Security policies, not by hiding this key.
# NEVER put the "service_role" key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
